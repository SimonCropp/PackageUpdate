<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.1" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.3" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="20.8.2" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.3.3" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
